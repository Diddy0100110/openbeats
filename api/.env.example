# ---------------------------------------------------------------------------
# OpenBeats API — environment variables
# Copy to `.env` for local development. On Render, set these in the dashboard
# (or leave the defaults, which are fine for the demo).
# ---------------------------------------------------------------------------

# Where SQLite + uploaded audio live.  Use a Render disk path (e.g. /data)
# to make uploads survive redeploys.
DATA_DIR=./data

# Optional: use Postgres instead of SQLite (Render hands out postgres://…)
# DATABASE_URL=postgresql://user:pass@host:5432/openbeats

# Seed the public-domain demo catalogue on first boot.
SEED_DEMO=true

# Probe remote demo tracks for their duration at seed time (a few seconds).
SEED_PROBE_DURATION=true

# Max size of a single upload, in megabytes.
MAX_UPLOAD_MB=200

# Comma-separated list of allowed browser origins, or * for any.
CORS_ORIGINS=*

# Seconds to wait for the upstream audio host.
UPSTREAM_TIMEOUT=30
