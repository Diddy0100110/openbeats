# Public (browser-safe) environment variables for the Expo app.
# Expo inlines every EXPO_PUBLIC_* value into the bundle at build time.
#
# Local development: point at the API running on your machine.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# When you deploy the API (e.g. Render), build the web bundle with:
#   EXPO_PUBLIC_API_URL=https://your-api.onrender.com npx expo export --platform web
