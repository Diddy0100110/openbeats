# Production API origin, baked into the web bundle by `npx expo export`.
#
# Expo loads `.env.production` for production builds and `.env` for local
# development, so `npm start` keeps talking to your machine while a deployed
# build talks to the real server.
#
# The URL below is the Render service created by the Blueprint in `render.yaml`.
# If you redeploy the API somewhere else, change it here and re-run:
#   npx expo export --platform web && eas deploy --prod
EXPO_PUBLIC_API_URL=https://openbeats-api.onrender.com
